# === Scheduler ===
# Vrijeme provjere svaki dan (cron format), default 07:00 po Zagreb vremenu
CRON_SCHEDULE=0 7 * * *
TIMEZONE=Europe/Zagreb

# === Scraper ===
# Pauza izmedu zahtjeva prema stranicama (ms), da se ne opterecuje server
REQUEST_DELAY_MS=3000
# Ako nova cijena odstupi vise od ovog omjera od stare (npr. 5x veca/manja),
# tretira se kao vjerojatna greska parsanja, ne kao stvarna promjena
PRICE_SANITY_MAX_RATIO=5

# === Baza (Postgres, postavlja je docker-compose.yml za "db" servis) ===
DB_HOST=db
DB_PORT=5432
DB_NAME=gold_tracker
DB_USER=gold_tracker
DB_PASSWORD=change-me

# === Server ===
PORT=4100

# === Email obavijesti ===
EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tvoj.email@gmail.com
SMTP_PASS=app_lozinka_ovdje
EMAIL_FROM=tvoj.email@gmail.com
EMAIL_TO=tvoj.email@gmail.com
