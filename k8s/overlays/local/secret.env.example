# Kopiraj u secret.env i postavi vrijednosti (secret.env je u .gitignore).
# ./scripts/k8s-local.sh up ga sam kreira ako ne postoji.
POSTGRES_PASSWORD=promijeni-me
# Email obavijesti - uključuju se s EMAIL_ENABLED=true u k8s/overlays/local/kustomization.yaml
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_TO=
